# Prepare the team invitation form and the links it sends.
# Save local values in .env. Real tokens and passwords belong outside source control.
# To preview messages locally, run the dev server with MAIL_MODE=log. Sending setup is in docs/email-setup.md.

APP_URL=http://localhost:3000 # Invitation links start with this origin; it must also match ORIGIN below.
HOST=127.0.0.1 # Network interface for the server; 127.0.0.1 is the local loopback address.
PORT=3000 # Production port number. A reverse proxy may expose a different public port.
DB_PATH=.data/app.sqlite # Team invitations, expiry tokens, and outgoing invitation messages; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # To issue invitations and inspect their status, use username admin with your own random password (minimum 16 characters).
OWNER_EMAIL=owner@example.com # Not used for team invitations; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Optional to clear: team invitations are routed without this reviewer setting.
MAIL_MODE=sandbox # Choose sandbox to inspect team invitations, production to send, or log for a development preview.
MAIL_FROM=sender@example.com # Use your verified Mailtrap domain for the production sender of team invitations.
MAILTRAP_PRODUCTION_TOKEN= # Your Mailtrap transactional send token for team invitations; leave empty for sandbox or log mode.
MAILTRAP_SANDBOX_TOKEN= # Your inbox integration provides this Sandbox API token; leave blank in log mode.
MAILTRAP_INBOX_ID= # Number identifying the Sandbox inbox for team invitations; available in its integration settings.
ORIGIN=http://localhost:3000 # Public origin SvelteKit should trust for team-invite actions; use the same address as APP_URL.
BODY_SIZE_LIMIT=16384 # Invitation request size limit, in bytes. The default is 16 KiB (16384).
MAILTRAP_TEMPLATE_UUID= # Optional production template UUID; use the matching template in email-templates/.
MAILTRAP_SANDBOX_TEMPLATE_UUID= # Optional template UUID accessible with the Sandbox token; blank uses built-in content.
